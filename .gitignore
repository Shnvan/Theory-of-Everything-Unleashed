# Local editor settings. The example file is committed so the editor setup is
# reproducible; the real settings.json stays local.
.vscode/*
!.vscode/settings.json.example
.idea/

# Local environment and credentials
.env
.env.*

# Operating-system files
.DS_Store
Thumbs.db

# Studio-owned place files
# The Studio place is the source of truth for the arena, GUI, rigs, and audio;
# see the source-of-truth table in docs/STUDIO_IDE_WORKFLOW.md. Nothing here is
# a repo-side backup, so the place must be published for recoverability.
*.rbxl
*.rbxlx

# Toolchain-generated output
Packages/
DevPackages/
ServerPackages/
sourcemap.json
roblox.yml
globalTypes.d.luau
build/

# Model exports
*.rbxm
*.rbxmx

# Third-party tooling fetched locally, not vendored. The Blender MCP addon is
# 122KB of someone else's code under a licence this project has not reviewed;
# pinning it by URL and SHA256 in ASSET_PROVENANCE_LEDGER.md is reproducible
# without taking on responsibility for reviewing and maintaining it.
tools/blender/

# Exhibit art. The committed source is art/exhibits/*/generate.py -- a script,
# not a binary -- so exported meshes are build output and stay out of git. This
# is safe because generators are GEOMETRICALLY deterministic: identical triangle
# count, vertex count, and dimensions on every run. Byte-identity is NOT
# guaranteed and is not needed. See art/README.md.
#
# Hand-sculpted exhibits that cannot be generated will need committed .blend
# files under Git LFS. None exist yet.
*.glb
*.gltf
*.blend
*.blend[0-9]
